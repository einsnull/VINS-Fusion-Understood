# VINS-Fusion with TensorRT support for SuperPoint + LightGlue
# Based on existing VINS-Fusion image with TensorRT added
# Using China mirrors for faster download

FROM ros:vins-fusion

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=kinetic
ENV CATKIN_WS=/root/catkin_ws

# Use China mirrors for apt
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list

# Install CUDA toolkit and TensorRT
# First add NVIDIA package repositories
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    gnupg \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Add NVIDIA CUDA repository
RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu1604/x86_64/cuda-repo-ubuntu1604_8.0.61-1_amd64.deb && \
    dpkg -i cuda-repo-ubuntu1604_8.0.61-1_amd64.deb || true && \
    rm cuda-repo-ubuntu1604_8.0.61-1_amd64.deb

# Try to install CUDA and TensorRT from apt
RUN apt-get update && apt-get install -y \
    cuda-toolkit-8-0 \
    libcudnn7 \
    libcudnn7-dev \
    || echo "CUDA 8 not available, trying alternative..."

# Alternative: Install TensorRT via NVIDIA repository
RUN apt-get update && apt-get install -y \
    tensorrt \
    libnvinfer5 \
    libnvinfer-dev \
    libnvonnxparsers5 \
    libnvonnxparsers-dev \
    || echo "TensorRT apt packages not available"

# Set CUDA environment variables (if CUDA was installed)
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Install Python3 and pip (for model conversion tools)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Configure pip to use China mirror
RUN pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple || true

# Install Python dependencies for model conversion
RUN pip3 install onnx onnxruntime || true

# Copy model files
COPY models/ /tmp/models/
COPY scripts/convert_onnx_to_trt.py /tmp/convert_onnx_to_trt.py

# Remove old VINS-Fusion code and copy new one
RUN rm -rf $CATKIN_WS/src/VINS-Fusion/*
COPY ./ $CATKIN_WS/src/VINS-Fusion/

# Rebuild VINS-Fusion with new code
WORKDIR $CATKIN_WS
ENV TERM=xterm
ENV PYTHONIOENCODING=UTF-8

# Source ROS and rebuild
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    catkin clean -y && \
    catkin config --extend /opt/ros/${ROS_DISTRO} --cmake-args \
    -DCMAKE_BUILD_TYPE=Release \
    -DUSE_TENSORRT=OFF && \
    catkin build"

# Set up entrypoint
RUN sed -i '/exec "$@"/i \
    source "/root/catkin_ws/devel/setup.bash"' /ros_entrypoint.sh || true

WORKDIR $CATKIN_WS
CMD ["/bin/bash"]
